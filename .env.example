# Shared secret for every showcase site that calls an NVIDIA NIM model
# (currently /showcase/stock-screener). Server-side only: no NEXT_PUBLIC_ prefix,
# because Next.js inlines those into the browser bundle and this key is billable.
# Read it only from route handlers / server components under app/api/.
NVIDIA_API_KEY=nvapi_REPLACE_ME
# NIM_MODEL=meta/llama-3.3-70b-instruct

# Each showcase site gets its own prefixed Supabase project so demos never share
# a database. Copy this file to .env.local and fill in real values.
# The NEXT_PUBLIC_ prefix is required: Next.js only exposes those vars to the
# browser, and Savour's wishlist writes happen client-side.
# Publishable keys are safe to ship to the client because Row Level Security
# restricts visitors to public catalogue reads plus their own wishlist rows.
NEXT_PUBLIC_SAVOUR_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SAVOUR_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Both values come from Supabase dashboard -> Project Settings -> API keys.
